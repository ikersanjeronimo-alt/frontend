VITE_BACKEND_URL=http://localhost:8080

# Mientras el backend no esté completo: si una petición falla por red
# (back caído / endpoint no implementado), el front cae a datos mock y
# muestra un banner "Modo demostración". Cuando el back funcione,
# poner en false (o eliminar) para que los errores se muestren al usuario.
VITE_USE_MOCK_FALLBACK=true
